@model IReadOnlyList<Label33.Domain.Entities.Order>
@inject Label33.Web.Localization.IBrandLocalizer L

<section class="panel account-panel">
    <header class="account-panel__head">
        <div>
            <div class="eyebrow">@L["nav.account"]</div>
            <h1 class="display">@User.Identity?.Name</h1>
        </div>
        <form asp-action="Logout" method="post">
            @Html.AntiForgeryToken()
            <button class="btn btn--ghost" type="submit">@L["account.logout"]</button>
        </form>
    </header>

    <h2 class="account-orders__title">@L["account.orders"]</h2>

    @if (Model.Count == 0)
    {
        <p class="account-orders__empty">@L["account.emptyOrders"]</p>
        <a class="btn" asp-controller="Shop" asp-action="Index">@L["nav.shop"]</a>
    }
    else
    {
        <div class="account-orders">
            @foreach (var order in Model)
            {
                <a class="account-order" asp-action="Order" asp-route-id="@order.Id">
                    <div>
                        <strong>@L["account.orderNumber"]: @order.OrderNumber</strong>
                        <div class="account-order__meta">@L["account.orderDate"]: @order.CreatedAtUtc.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</div>
                    </div>
                    <div class="account-order__side">
                        <span class="ops-badge">@order.Status</span>
                        <span>@Money.FormatToman(order.GrandTotal) @Money.DisplayUnit</span>
                    </div>
                </a>
            }
        </div>
    }
</section>

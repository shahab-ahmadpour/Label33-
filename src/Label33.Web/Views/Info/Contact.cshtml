@inject Label33.Web.Localization.IBrandLocalizer L

<section class="container story trust-page">
    <div class="eyebrow eyebrow-brand">
        <img class="brand-mark brand-mark--eyebrow" src="~/brand/logo/33-mark.png" alt="33" width="72" height="56" />
    </div>
    <h1 class="display">@L["trust.contact.title"]</h1>
    <div class="trust-page__body">
        <p>@L["trust.contact.p1"]</p>
        <ul class="trust-page__list">
            <li>Instagram: <a href="https://instagram.com/33label" target="_blank" rel="noopener">@@33label</a></li>
            <li>Telegram: <a href="https://t.me/33label" target="_blank" rel="noopener">@@33label</a></li>
            <li>Email: <a href="mailto:hello@33label.ir">hello@33label.ir</a></li>
            <li>Tel: <a href="tel:+989001234567">+98 900 123 4567</a></li>
        </ul>
        <p>@L["trust.contact.p2"]</p>
    </div>
</section>

@inject Label33.Web.Localization.IBrandLocalizer L

<section class="container story trust-page">
    <div class="eyebrow">33</div>
    <h1 class="display">@L["trust.shipping.title"]</h1>
    <div class="trust-page__body">
        <p>@L["trust.shipping.p1"]</p>
        <p>@L["trust.shipping.p2"]</p>
        <p>@L["trust.shipping.p3"]</p>
        <p><strong>@L["checkout.shippingCost"]:</strong> @Money.FormatToman(500_000m) @Money.DisplayUnit</p>
    </div>
</section>

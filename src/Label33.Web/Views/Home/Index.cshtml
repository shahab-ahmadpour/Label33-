@model IReadOnlyList<Label33.Application.Catalog.ProductListItemDto>
@{
    ViewData["Title"] = "33 Label";
}

<div class="text-center">
    <h1 class="display-5">33 Label</h1>
    <p class="lead">Backend scaffold is live. UI/UX will follow your design document.</p>
</div>

@if (Model.Count == 0)
{
    <p class="text-muted">No published products yet.</p>
}
else
{
    <ul>
    @foreach (var p in Model)
    {
        <li>
            <a href="/products/@p.Slug">@p.Name</a>
            @if (p.FromPrice.HasValue) { <span> — @p.FromPrice.Value.ToString("N0") IRR</span> }
        </li>
    }
    </ul>
}

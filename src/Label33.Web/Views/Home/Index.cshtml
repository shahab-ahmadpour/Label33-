@model IReadOnlyList<Label33.Application.Catalog.ProductListItemDto>
@inject Label33.Web.Localization.IBrandLocalizer L
@{
    ViewData["Title"] = "Home";
}

<section class="hero-home" aria-label="33">
    <div class="hero-home__cream">
        <div class="hero-home__eyebrow">
            <img class="brand-mark brand-mark--eyebrow" src="~/brand/logo/33-mark.png" alt="33" width="72" height="56" />
            <span>/ since 2026</span>
        </div>
        <h1 class="hero-home__title">
            <span class="line">SAME CLOTHES.</span>
            <span class="line">DIFFERENT MINDS.</span>
        </h1>
        <p class="hero-home__support">@L["hero.support"]</p>
        <div class="hero-home__cta">
            <a class="btn" asp-controller="Shop" asp-action="Index">@L["hero.cta.shop"] →</a>
            <a class="btn btn--ghost" asp-controller="Diyar" asp-action="Index">@L["hero.cta.diyar"] →</a>
        </div>
        <a class="hero-home__scroll" href="#home-shop">@L["hero.scroll"] ↓</a>
    </div>
    <div class="hero-home__forest" aria-hidden="true">
        <span class="hero-home__gold"></span>
    </div>
    <img class="hero-home__bird" src="~/brand/diyar/diyar-main.png" alt="" width="300" height="300" />
</section>

<section class="band band--ember">
    <div class="container band-manifesto">
        <div class="eyebrow">Manifesto</div>
        <h2 class="display band-manifesto__title">@L["home.manifestoTitle"]</h2>
    </div>
</section>

@if (Model.Count > 0)
{
    <section class="home-shop" id="home-shop">
        <div class="container">
            <div class="home-shop__head">
                <h2 class="home-shop__title">@L["shop.title"]</h2>
                <a class="home-shop__all" asp-controller="Shop" asp-action="Index">@L["shop.viewAll"] ↗</a>
            </div>
            <div class="product-grid product-grid--home">
                @foreach (var p in Model.Take(4))
                {
                    <article class="product-card product-card--dark">
                        <a class="product-card__link" asp-controller="Products" asp-action="Details" asp-route-slug="@p.Slug">
                            <div class="product-card__media">
                                <img src="@Url.Content(StorefrontMedia.Resolve(p.PrimaryImage))" alt="@p.Name" class="@(string.IsNullOrWhiteSpace(p.PrimaryImage) ? "is-fallback" : "is-photo")" />
                            </div>
                        </a>
                        <div class="product-card__meta">
                            <div class="product-card__info">
                                <div class="product-card__name">@p.Name</div>
                                @if (p.FromPrice.HasValue)
                                {
                                    <div class="product-card__price">@Money.FormatToman(p.FromPrice.Value) @Money.DisplayUnit</div>
                                }
                            </div>
                            <form asp-controller="Cart" asp-action="QuickAdd" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="slug" value="@p.Slug" />
                                <button class="btn btn--tan" type="submit">@L["shop.quickAdd"]</button>
                            </form>
                        </div>
                    </article>
                }
            </div>
        </div>
    </section>
}

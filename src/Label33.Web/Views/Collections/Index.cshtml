@model IReadOnlyList<Label33.Application.Catalog.ProductListItemDto>
@inject Label33.Web.Localization.IBrandLocalizer L
@{
    ViewData["Title"] = L["collections.title"];

    var slots = new (string Key, string Label, string Tone)[]
    {
        ("T-SHIRTS", "T-SHIRTS", "cream"),
        ("HOODIES", "HOODIES", "teal"),
        ("SWEATSHIRTS", "SWEATSHIRTS", "slate"),
        ("JOGGERS", "JOGGERS", "forest")
    };

    Label33.Application.Catalog.ProductListItemDto? Pick(string category)
    {
        bool Match(Label33.Application.Catalog.ProductListItemDto p) =>
            string.Equals(p.ShortDescription, category, StringComparison.OrdinalIgnoreCase)
            || (category == "T-SHIRTS" && (
                Contains(p, "Tee") || Contains(p, "T-Shirt") || Contains(p, "Tshirt") || Contains(p, "تی")))
            || (category == "HOODIES" && (Contains(p, "Hoodie") || Contains(p, "هودی")))
            || (category == "SWEATSHIRTS" && (Contains(p, "Sweat") || Contains(p, "سویش") || Contains(p, "Crew")))
            || (category == "JOGGERS" && (Contains(p, "Jogger") || Contains(p, "جاگر")));

        return Model.FirstOrDefault(Match);
    }

    static bool Contains(Label33.Application.Catalog.ProductListItemDto p, string token) =>
        (p.Name?.Contains(token, StringComparison.OrdinalIgnoreCase) ?? false)
        || (p.ShortDescription?.Contains(token, StringComparison.OrdinalIgnoreCase) ?? false);
}

<section class="collection-board">
    <div class="container collection-board__head">
        <div class="eyebrow eyebrow-brand">
            <img class="brand-mark brand-mark--eyebrow" src="~/brand/logo/33-mark-cream.png" alt="33" width="72" height="56" />
        </div>
        <h1 class="collection-board__title">@L["collections.title"]</h1>
        <p class="collection-board__intro">@L["collections.intro"]</p>
    </div>

    <div class="container">
        <div class="collection-grid">
            @for (var i = 0; i < slots.Length; i++)
            {
                var slot = slots[i];
                var product = Pick(slot.Key);
                var heightClass = (i % 4) switch
                {
                    0 => "collection-card--mid",
                    1 => "collection-card--tall",
                    2 => "collection-card--short",
                    _ => "collection-card--tall"
                };

                <a class="collection-card @heightClass"
                   asp-controller="Shop"
                   asp-action="Index"
                   asp-route-category="@slot.Key">
                    <div class="collection-card__media collection-card__media--@slot.Tone">
                        @if (product is not null && !string.IsNullOrWhiteSpace(product.PrimaryImage))
                        {
                            <img src="@Url.Content(StorefrontMedia.Resolve(product.PrimaryImage))" alt="@product.Name" />
                        }
                        else
                        {
                            <img class="collection-card__fallback" src="~/brand/diyar/diyar-main.png" alt="" />
                        }
                    </div>
                    <div class="collection-card__meta">
                        <div class="collection-card__cat">@slot.Label</div>
                        <div class="collection-card__row">
                            <div class="collection-card__name">@(product?.Name ?? slot.Label)</div>
                            @if (product?.FromPrice is decimal price)
                            {
                                <div class="collection-card__price">@Money.FormatToman(price) @Money.DisplayUnit</div>
                            }
                        </div>
                    </div>
                </a>
            }
        </div>
    </div>
</section>

@model IReadOnlyList<Label33.Application.Catalog.ProductListItemDto>
@inject Label33.Web.Localization.IBrandLocalizer L
@{
    var categories = ViewData["Categories"] as IReadOnlyList<Label33.Application.Catalog.CategoryDto>
        ?? Array.Empty<Label33.Application.Catalog.CategoryDto>();
    var tones = new[] { "cat-tile--ink", "cat-tile--olive", "cat-tile--tan", "cat-tile--ember" };
}

<section class="container story" style="padding-bottom:2rem;">
    <div class="eyebrow">33</div>
    <h1 class="display">@L["collections.title"]</h1>
    <p style="max-width:36rem;color:var(--muted);">@L["collections.intro"]</p>
</section>

<section class="container">
    <div class="cat-grid">
        @if (categories.Count == 0)
        {
            <a class="cat-tile cat-tile--ink" asp-controller="Shop" asp-action="Index" asp-route-category="T-SHIRTS">T-Shirts</a>
            <a class="cat-tile cat-tile--olive" asp-controller="Shop" asp-action="Index" asp-route-category="HOODIES">Hoodies</a>
            <a class="cat-tile cat-tile--tan" asp-controller="Shop" asp-action="Index" asp-route-category="SWEATSHIRTS">Sweatshirts</a>
            <a class="cat-tile cat-tile--ember" asp-controller="Shop" asp-action="Index" asp-route-category="JOGGERS">Joggers</a>
        }
        else
        {
            @for (var i = 0; i < categories.Count; i++)
            {
                var c = categories[i];
                <a class="cat-tile @tones[i % tones.Length]" asp-controller="Shop" asp-action="Index" asp-route-category="@c.Name">@c.Name</a>
            }
        }
    </div>
</section>

<section class="hero hero--dark" style="min-height:64vh;">
    <div class="hero__visual">
        <img src="~/brand/diyar/diyar-main.png" alt="Campaign" />
    </div>
    <div class="hero__content">
        <div class="eyebrow">Campaign</div>
        <h2 class="display">Everyday Uniform</h2>
        <p>@L["collections.campaign"]</p>
        <a class="btn btn--tan" asp-controller="Shop" asp-action="Index">@L["hero.cta.shop"]</a>
    </div>
</section>

<section class="container" style="padding-block:4rem;">
    <div class="product-grid">
        @foreach (var p in Model.Take(6))
        {
            <article class="product-card">
                <a asp-controller="Products" asp-action="Details" asp-route-slug="@p.Slug">
                    <div class="product-card__media">
                        <img src="@Url.Content(StorefrontMedia.Resolve(p.PrimaryImage))" alt="@p.Name" class="@(string.IsNullOrWhiteSpace(p.PrimaryImage) ? "is-fallback" : "is-photo")" />
                    </div>
                </a>
                <div class="product-card__meta" style="opacity:1;transform:none;position:relative;background:transparent;">
                    <div>
                        <div class="product-card__name">@p.Name</div>
                        @if (p.FromPrice.HasValue)
                        {
                            <div class="product-card__price">@Money.FormatToman(p.FromPrice.Value) @Money.DisplayUnit</div>
                        }
                    </div>
                </div>
            </article>
        }
    </div>
</section>

@model IReadOnlyList<Label33.Application.Catalog.ProductListItemDto>
@inject Label33.Web.Localization.IBrandLocalizer L
@{
    var category = (ViewData["Category"] as string) ?? "ALL";
    var query = (ViewData["Query"] as string) ?? "";
    string[] cats = ["ALL", "T-SHIRTS", "HOODIES", "SWEATSHIRTS", "JOGGERS"];
    string Label(string c) => c switch
    {
        "ALL" => L["shop.all"],
        "T-SHIRTS" => L["shop.tshirts"],
        "HOODIES" => L["shop.hoodies"],
        "SWEATSHIRTS" => L["shop.sweatshirts"],
        "JOGGERS" => L["shop.joggers"],
        _ => c
    };
}

<div class="shop-page">
<section class="container page-head">
    <div class="eyebrow">33 / since 2026</div>
    <h1 class="display">@L["shop.title"]</h1>
    @if (!string.IsNullOrWhiteSpace(query))
    {
        <p class="search-result-note">@L["search.resultsFor"] “@query”</p>
    }
</section>

<section class="container">
    <form class="shop-search" method="get" asp-controller="Shop" asp-action="Index" role="search">
        @if (!string.Equals(category, "ALL", StringComparison.OrdinalIgnoreCase))
        {
            <input type="hidden" name="category" value="@category" />
        }
        <input type="search" name="q" value="@query" placeholder="@L["search.placeholder"]" />
        <button class="btn btn--tan" type="submit">@L["nav.search"]</button>
    </form>

    <div class="filters">
        @foreach (var c in cats)
        {
            <a class="@(string.Equals(category, c, StringComparison.OrdinalIgnoreCase) ? "is-active" : null)"
               asp-controller="Shop" asp-action="Index" asp-route-category="@c" asp-route-q="@query">@Label(c)</a>
        }
    </div>

    @if (Model.Count == 0)
    {
        <p>@(string.IsNullOrWhiteSpace(query) ? L["shop.empty"] : L["search.empty"])</p>
    }
    else
    {
        <div class="product-grid">
            @foreach (var p in Model)
            {
                <article class="product-card">
                    <a asp-controller="Products" asp-action="Details" asp-route-slug="@p.Slug">
                        <div class="product-card__media">
                            <img src="@Url.Content(StorefrontMedia.Resolve(p.PrimaryImage))" alt="@p.Name" class="@(string.IsNullOrWhiteSpace(p.PrimaryImage) ? "is-fallback" : "is-photo")" />
                        </div>
                    </a>
                    <div class="product-card__meta">
                        <div>
                            <div class="product-card__name">@p.Name</div>
                            @if (p.FromPrice.HasValue)
                            {
                                <div class="product-card__price">@Money.FormatToman(p.FromPrice.Value) @Money.DisplayUnit</div>
                            }
                        </div>
                        <form asp-controller="Cart" asp-action="QuickAdd" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="slug" value="@p.Slug" />
                            <button class="btn btn--tan" type="submit">@L["shop.quickAdd"]</button>
                        </form>
                    </div>
                </article>
            }
        </div>
    }
</section>

</div>

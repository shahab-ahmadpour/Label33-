@inject Label33.Web.Localization.IBrandLocalizer L

<section class="container story" style="padding-bottom:2rem;">
    <div class="story-grid">
        <div>
            <div class="eyebrow">33 LABEL</div>
            <h1 class="display">@L["about.title"]</h1>
            <p style="font-size:1.15rem;max-width:36rem;">@L["about.body"]</p>
            <p style="color:var(--muted);max-width:36rem;">SAME CLOTHES. DIFFERENT MINDS.</p>
            <div style="margin-top:1.5rem;">
                <a class="btn" asp-controller="Shop" asp-action="Index">@L["hero.cta.shop"]</a>
            </div>
        </div>
        <div class="story-grid__visual">
            <img src="~/brand/diyar/diyar-main.png" alt="Diyar" style="width:min(100%,520px);height:auto;" />
        </div>
    </div>
</section>

<section class="band band--olive">
    <div class="container" style="display:grid;gap:1rem;max-width:40rem;">
        <div class="eyebrow">Identity</div>
        <h2 class="display" style="margin:0;font-size:clamp(1.6rem,3.5vw,2.4rem);">Ink · Olive · Tan</h2>
        <p style="margin:0;">سیستم رنگی 33 از مشکی عمیق، زیتونی و بژ ساخته شده — برای لباس، پکیج و تجربه دیجیتال یکسان.</p>
    </div>
</section>

<section class="band band--ink">
    <div class="container" style="display:grid;gap:.75rem;max-width:40rem;">
        <div class="eyebrow">EST. 2024</div>
        <h2 class="display" style="margin:0;color:var(--tan);font-size:clamp(1.6rem,3.5vw,2.4rem);">Three people. Three perspectives. One brand.</h2>
    </div>
</section>

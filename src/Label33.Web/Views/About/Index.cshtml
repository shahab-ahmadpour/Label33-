@inject Label33.Web.Localization.IBrandLocalizer L

<section class="container story">
    <div class="story-grid">
        <div>
            <div class="eyebrow">33</div>
            <h1 class="display">@L["about.title"]</h1>
            <p style="font-size:1.15rem;max-width:36rem;">@L["about.body"]</p>
            <p style="color:var(--muted);max-width:36rem;">SAME CLOTHES. DIFFERENT MINDS.</p>
            <div style="margin-top:1.5rem;">
                <a class="btn" asp-controller="Shop" asp-action="Index">@L["hero.cta.shop"]</a>
            </div>
        </div>
        <div class="story-grid__visual">
            <img src="~/brand/diyar/diyar-flight.svg" alt="Diyar" style="width:min(100%,520px);height:auto;" />
        </div>
    </div>
</section>

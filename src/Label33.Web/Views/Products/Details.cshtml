@model Label33.Application.Catalog.ProductDetailDto
@inject Label33.Web.Localization.IBrandLocalizer L

<section class="container pdp">
    <div class="pdp__gallery">
        <img src="~/brand/diyar/diyar-mark.svg" alt="@Model.Name" />
    </div>
    <div class="pdp__info">
        <div class="eyebrow">33</div>
        <h1 class="display">@Model.Name</h1>
        @{
            var price = Model.Variants.FirstOrDefault()?.BasePrice;
        }
        @if (price.HasValue)
        {
            <div class="pdp__price">@price.Value.ToString("N0") IRR</div>
        }

        <form asp-controller="Cart" asp-action="Add" method="post" class="stack">
            @Html.AntiForgeryToken()
            <div class="field">
                <label>@L["product.size"]</label>
                <select name="variantId" required>
                    @foreach (var v in Model.Variants)
                    {
                        <option value="@v.Id">@v.Title — @v.BasePrice.ToString("N0")</option>
                    }
                </select>
            </div>
            <div class="field">
                <label>@L["product.qty"]</label>
                <input type="number" name="quantity" value="1" min="1" />
            </div>
            <button class="btn" type="submit">@L["product.add"]</button>
        </form>

        <div class="pdp__aside">
            <p>@(Model.ShortDescription ?? Model.FullDescription)</p>
            <p><strong>@L["product.materials"]</strong> — Cotton blend / soft handfeel</p>
            <p><strong>@L["product.sizeGuide"]</strong> — M / L / XL</p>
            <p><strong>@L["product.shipping"]</strong> — Iran-wide</p>
            <img class="diyar-mark-inline" src="~/brand/diyar/diyar-mark.svg" alt="Diyar" />
        </div>
    </div>
</section>

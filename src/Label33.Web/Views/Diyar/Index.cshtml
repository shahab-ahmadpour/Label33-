@inject Label33.Web.Localization.IBrandLocalizer L

<section class="container story">
    <div class="story-grid story-grid--rev">
        <div class="story-grid__visual">
            <img src="~/brand/diyar/diyar-mark.svg" alt="Diyar" style="width:min(100%,420px);height:auto;" />
        </div>
        <div>
            <div class="eyebrow">DIYAR</div>
            <h1 class="display">@L["diyar.title"]</h1>
            <p style="font-size:1.1rem;max-width:34rem;">@L["diyar.intro"]</p>
            <ul class="trait-list">
                <li>Free</li>
                <li>Curious</li>
                <li>Adaptable</li>
                <li>Restless</li>
                <li>Distinctive</li>
                <li>Open-minded</li>
            </ul>
        </div>
    </div>

    <div class="pose-row">
        <figure>
            <div class="pose-flight" style="width:100%;color:var(--charcoal);">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 360" class="diyar-svg" data-flap="idle" fill="none">
                    <g class="diyar-svg__bird" fill="currentColor">
                        <g class="diyar-svg__wing-pivot" transform="rotate(0 348 185)">
                            <path class="diyar-svg__wing" d="M348 185C310 155 250 105 160 55C120 30 85 15 55 18C95 55 145 100 200 135C250 165 305 180 348 185C310 200 245 235 155 280C115 305 80 320 52 318C95 280 155 240 215 215C270 190 320 185 348 185Z"/>
                        </g>
                        <path d="M320 168C350 150 395 145 445 155C490 164 525 185 545 210C520 205 490 198 460 200C430 202 400 210 375 220C355 228 340 230 328 222C318 210 314 190 320 168Z"/>
                        <path d="M445 155C470 140 500 135 535 142C555 147 575 160 590 175C565 168 545 162 525 162C505 162 485 165 470 172C458 168 450 162 445 155Z"/>
                        <path d="M588 172L655 188L590 186Z"/>
                        <path d="M328 210C300 225 265 245 235 275C270 250 300 235 325 222C340 235 350 255 352 280C345 250 338 230 328 210Z"/>
                    </g>
                </svg>
            </div>
            <figcaption class="eyebrow" style="margin-top:.75rem;">Flight</figcaption>
        </figure>
        <figure><img src="~/brand/diyar/diyar-mark.svg" alt="Diyar mark" style="width:100%;height:auto;" /><figcaption class="eyebrow" style="margin-top:.75rem;">Mark</figcaption></figure>
        <figure><img src="~/brand/diyar/diyar-mark.svg" alt="Diyar icon" style="width:70%;height:auto;margin-inline:auto;" /><figcaption class="eyebrow" style="margin-top:.75rem;">Icon</figcaption></figure>
    </div>
</section>

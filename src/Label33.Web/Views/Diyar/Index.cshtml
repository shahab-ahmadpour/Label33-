@inject Label33.Web.Localization.IBrandLocalizer L

<section class="container story">
    <div class="story-grid story-grid--rev">
        <div class="story-grid__visual">
            <img src="~/brand/diyar/diyar-mark.png" alt="Diyar" style="mix-blend-mode:multiply;" />
        </div>
        <div>
            <div class="eyebrow">DIYAR</div>
            <h1 class="display">@L["diyar.title"]</h1>
            <p style="font-size:1.1rem;max-width:34rem;">@L["diyar.intro"]</p>
            <ul class="trait-list">
                <li>Free</li>
                <li>Curious</li>
                <li>Adaptable</li>
                <li>Restless</li>
                <li>Distinctive</li>
                <li>Open-minded</li>
            </ul>
        </div>
    </div>

    <div class="pose-row">
        <figure><img src="~/brand/diyar/diyar-icon.png" alt="Diyar icon" /><figcaption class="eyebrow" style="margin-top:.75rem;">Icon</figcaption></figure>
        <figure><img src="~/brand/diyar/diyar-profile.png" alt="Diyar profile" /><figcaption class="eyebrow" style="margin-top:.75rem;">Profile</figcaption></figure>
        <figure><img src="~/brand/diyar/diyar-flight.png" alt="Diyar flight" /><figcaption class="eyebrow" style="margin-top:.75rem;">Flight</figcaption></figure>
    </div>
</section>

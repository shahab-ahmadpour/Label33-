@inject Label33.Web.Localization.IBrandLocalizer L

<section class="container story">
    <div class="story-grid story-grid--rev">
        <div class="story-grid__visual">
            <img src="~/brand/diyar/diyar-main.png" alt="Diyar" style="width:min(100%,420px);height:auto;" />
        </div>
        <div>
            <div class="eyebrow">DIYAR</div>
            <h1 class="display">@L["diyar.title"]</h1>
            <p style="font-size:1.1rem;max-width:34rem;">@L["diyar.intro"]</p>
            <ul class="trait-list">
                <li>Free</li>
                <li>Curious</li>
                <li>Adaptable</li>
                <li>Restless</li>
                <li>Distinctive</li>
                <li>Open-minded</li>
            </ul>
        </div>
    </div>

    <div class="pose-row">
        <figure>
            <div class="pose-flight">
                <div class="diyar-flap diyar-flap--pose" data-flap="idle" data-flap-root>
                    <img class="diyar-flap__frame is-active" src="~/brand/diyar/diyar-flap-01.png" alt="" width="720" height="720" />
                    <img class="diyar-flap__frame" src="~/brand/diyar/diyar-flap-02.png" alt="" width="720" height="720" />
                    <img class="diyar-flap__frame" src="~/brand/diyar/diyar-flap-03.png" alt="" width="720" height="720" />
                    <img class="diyar-flap__frame" src="~/brand/diyar/diyar-flap-04.png" alt="" width="720" height="720" />
                </div>
            </div>
            <figcaption class="eyebrow" style="margin-top:.75rem;">Flight</figcaption>
        </figure>
        <figure><img src="~/brand/diyar/diyar-mark.svg" alt="Diyar mark" style="width:100%;height:auto;" /><figcaption class="eyebrow" style="margin-top:.75rem;">Mark</figcaption></figure>
        <figure><img src="~/brand/diyar/diyar-mark.svg" alt="Diyar icon" style="width:70%;height:auto;margin-inline:auto;" /><figcaption class="eyebrow" style="margin-top:.75rem;">Icon</figcaption></figure>
    </div>
</section>

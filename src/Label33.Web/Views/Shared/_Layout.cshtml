@using Label33.Web.Localization
@inject IBrandLocalizer L
<!DOCTYPE html>
<html lang="@L.Culture" dir="@(L.IsRtl ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] != null ? $"{ViewData["Title"]} — " : "")۳۳</title>
    <link rel="icon" href="~/brand/diyar/diyar-mark.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=Vazirmatn:wght@400;500;600&display=swap" rel="stylesheet" />
    <link href="https://api.fontshare.com/v2/css?f[]=satoshi@400,500,600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/brand.css" asp-append-version="true" />
</head>
<body>
@if (ViewData["ShowIntro"] as bool? == true)
{
    <div class="intro" id="site-intro" aria-hidden="false">
        <div class="intro__bird" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 360" class="diyar-svg" fill="none" focusable="false">
                <g class="diyar-svg__bird" fill="currentColor">
                    <g class="diyar-svg__wing-pivot" transform="rotate(0 348 185)">
                        <path class="diyar-svg__wing" d="M348 185C310 155 250 105 160 55C120 30 85 15 55 18C95 55 145 100 200 135C250 165 305 180 348 185C310 200 245 235 155 280C115 305 80 320 52 318C95 280 155 240 215 215C270 190 320 185 348 185Z"/>
                    </g>
                    <path d="M320 168C350 150 395 145 445 155C490 164 525 185 545 210C520 205 490 198 460 200C430 202 400 210 375 220C355 228 340 230 328 222C318 210 314 190 320 168Z"/>
                    <path d="M445 155C470 140 500 135 535 142C555 147 575 160 590 175C565 168 545 162 525 162C505 162 485 165 470 172C458 168 450 162 445 155Z"/>
                    <path d="M588 172L655 188L590 186Z"/>
                    <path d="M328 210C300 225 265 245 235 275C270 250 300 235 325 222C340 235 350 255 352 280C345 250 338 230 328 210Z"/>
                </g>
            </svg>
        </div>
        <div class="intro__copy">
            <p class="brand-num">۳۳</p>
            <p class="tag">SAME CLOTHES.
DIFFERENT MINDS.</p>
        </div>
        <button type="button" class="intro__skip" id="intro-skip">@L["intro.skip"]</button>
    </div>
}

<header class="site-header">
    <div class="container nav" id="site-nav">
        <a class="nav__brand" asp-controller="Home" asp-action="Index" aria-label="33">
            <img src="~/brand/diyar/diyar-mark.svg" alt="" width="32" height="32" />
            <span class="nav__brand-word">۳۳</span>
        </a>

        <button class="nav__burger" id="nav-burger" type="button" aria-label="Menu"><span></span><span></span><span></span></button>

        <ul class="nav__links">
            <li><a asp-controller="Shop" asp-action="Index">@L["nav.shop"]</a></li>
            <li><a asp-controller="Collections" asp-action="Index">@L["nav.collections"]</a></li>
            <li><a asp-controller="About" asp-action="Index">@L["nav.about"]</a></li>
            <li><a asp-controller="Diyar" asp-action="Index">@L["nav.diyar"]</a></li>
        </ul>

        <div class="nav__actions">
            <a class="hide-sm" asp-controller="Shop" asp-action="Index" asp-route-q="">@L["nav.search"]</a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-controller="Account" asp-action="Index">@L["nav.account"]</a>
            }
            else
            {
                <a asp-controller="Account" asp-action="Login">@L["nav.login"]</a>
            }
            <a asp-controller="Cart" asp-action="Index">@L["nav.cart"]</a>
            <form asp-controller="Culture" asp-action="Set" method="post" style="display:inline">
                @Html.AntiForgeryToken()
                <input type="hidden" name="culture" value="@(L.Culture == "fa" ? "en" : "fa")" />
                <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                <button class="lang-toggle" type="submit" aria-pressed="true">@(L.Culture == "fa" ? "EN" : "FA")</button>
            </form>
        </div>
    </div>
</header>

<main>
    @RenderBody()
</main>

<footer class="site-footer">
    <div class="container site-footer__grid">
        <div>
            <strong>۳۳</strong>
            <div>@L["footer.tag"]</div>
        </div>
        <div>33label</div>
    </div>
</footer>

<script src="~/js/brand.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>

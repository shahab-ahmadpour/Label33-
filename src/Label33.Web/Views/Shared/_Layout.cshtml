@using Label33.Web.Localization
@inject IBrandLocalizer L
<!DOCTYPE html>
<html lang="@L.Culture" dir="@(L.IsRtl ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] != null ? $"{ViewData["Title"]} — " : "")33</title>
    <link rel="icon" href="~/brand/diyar/diyar-main.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,600;1,9..144,500;1,9..144,600&display=swap" rel="stylesheet" />
    <link href="https://api.fontshare.com/v2/css?f[]=satoshi@400,500,600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/pelak.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/brand.css" asp-append-version="true" />
</head>
<body>
@if (ViewData["ShowIntro"] as bool? == true)
{
    <div class="intro" id="site-intro" aria-hidden="false">
        <div class="intro__bird" aria-hidden="true">
            <div class="diyar-flap" data-flap-root>
                <img class="diyar-flap__frame is-active" src="~/brand/diyar/diyar-flap-01.png" alt="" width="720" height="720" />
                <img class="diyar-flap__frame" src="~/brand/diyar/diyar-flap-02.png" alt="" width="720" height="720" />
                <img class="diyar-flap__frame" src="~/brand/diyar/diyar-flap-03.png" alt="" width="720" height="720" />
                <img class="diyar-flap__frame" src="~/brand/diyar/diyar-flap-04.png" alt="" width="720" height="720" />
            </div>
        </div>
        <div class="intro__copy">
            <p class="brand-num">33</p>
            <p class="tag">SAME CLOTHES.
DIFFERENT MINDS.</p>
        </div>
        <button type="button" class="intro__skip" id="intro-skip">@L["intro.skip"]</button>
    </div>
}

<header class="site-header">
    <div class="container nav" id="site-nav">
        <a class="nav__brand" asp-controller="Home" asp-action="Index" aria-label="33 Label">
            <span class="nav__brand-word">33</span>
            <img src="~/brand/diyar/diyar-mark.png" alt="" width="28" height="28" />
        </a>

        <button class="nav__burger" id="nav-burger" type="button" aria-label="Menu"><span></span><span></span><span></span></button>

        <ul class="nav__links">
            <li><a asp-controller="Shop" asp-action="Index">@L["nav.shop"]</a></li>
            <li><a asp-controller="Collections" asp-action="Index">@L["nav.collections"]</a></li>
            <li><a asp-controller="About" asp-action="Index">@L["nav.about"]</a></li>
            <li><a asp-controller="Diyar" asp-action="Index">@L["nav.diyar"]</a></li>
        </ul>

        <div class="nav__actions">
            <a class="nav__icon" href="#" id="search-toggle" aria-label="@L["nav.search"]" title="@L["nav.search"]">
                <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5"/><path d="M16.5 16.5L21 21"/></svg>
            </a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a class="nav__icon" asp-controller="Account" asp-action="Index" aria-label="@L["nav.account"]" title="@L["nav.account"]">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="3.5"/><path d="M5 19c1.8-3.2 4.2-4.8 7-4.8s5.2 1.6 7 4.8"/></svg>
                </a>
            }
            else
            {
                <a class="nav__icon" asp-controller="Account" asp-action="Login" aria-label="@L["nav.login"]" title="@L["nav.login"]">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="3.5"/><path d="M5 19c1.8-3.2 4.2-4.8 7-4.8s5.2 1.6 7 4.8"/></svg>
                </a>
            }
            <a class="nav__icon" asp-controller="Cart" asp-action="Index" aria-label="@L["nav.cart"]" title="@L["nav.cart"]">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 8h12l-1.2 11H7.2L6 8z"/><path d="M9 8a3 3 0 0 1 6 0"/></svg>
            </a>
            <form asp-controller="Culture" asp-action="Set" method="post" style="display:inline">
                @Html.AntiForgeryToken()
                <input type="hidden" name="culture" value="@(L.Culture == "fa" ? "en" : "fa")" />
                <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                <button class="lang-toggle" type="submit" aria-pressed="true">@(L.Culture == "fa" ? "EN" : "FA")</button>
            </form>
        </div>
    </div>
</header>

<main>
    @if (TempData["Error"] is string flashError)
    {
        <div class="container"><div class="flash flash--error" role="alert">@flashError</div></div>
    }
    @if (TempData["Ok"] is string flashOk)
    {
        <div class="container"><div class="flash flash--ok" role="status">@flashOk</div></div>
    }
    @RenderBody()
</main>

<footer class="site-footer">
    <div class="container">
        <div class="site-footer__top">
            <div class="site-footer__brand">
                <div class="site-footer__num">33</div>
                <div class="site-footer__tag">@L["footer.tag"]</div>
                <div class="site-footer__since">since 2026</div>
            </div>
            <div class="site-footer__cols">
                <div class="site-footer__col">
                    <div class="site-footer__heading">@L["footer.shop"]</div>
                    <a asp-controller="Shop" asp-action="Index">@L["nav.shop"]</a>
                    <a asp-controller="Collections" asp-action="Index">@L["nav.collections"]</a>
                    <a asp-controller="Info" asp-action="Shipping">@L["footer.shipping"]</a>
                </div>
                <div class="site-footer__col">
                    <div class="site-footer__heading">@L["footer.discover"]</div>
                    <a asp-controller="About" asp-action="Index">@L["nav.about"]</a>
                    <a asp-controller="Diyar" asp-action="Index">@L["nav.diyar"]</a>
                    <a asp-controller="Info" asp-action="Contact">@L["footer.contact"]</a>
                </div>
                <div class="site-footer__col">
                    <div class="site-footer__heading">@L["footer.follow"]</div>
                    <a href="https://instagram.com/33label" target="_blank" rel="noopener">@@33label</a>
                    <a href="https://instagram.com/33label" target="_blank" rel="noopener">Instagram</a>
                    <a href="https://t.me/33label" target="_blank" rel="noopener">Telegram</a>
                </div>
            </div>
        </div>

        <div class="site-footer__flight">
            <div class="site-footer__flight-copy">@L["footer.flightList"]</div>
            <form class="site-footer__flight-form" action="#" method="post" onsubmit="return false;">
                <label class="sr-only" for="flight-email">Email</label>
                <input id="flight-email" type="email" name="email" placeholder="@L["footer.emailPlaceholder"]" autocomplete="email" />
                <button type="submit" aria-label="Join">→</button>
            </form>
        </div>

        <div class="site-footer__bottom">
            <div>© 2026 33. @L["footer.rights"]</div>
            <img class="site-footer__bird" src="~/brand/diyar/diyar-main.png" alt="" width="44" height="44" />
            <div>@L["footer.designed"]</div>
        </div>
    </div>
</footer>

<div class="search-panel" id="search-panel" aria-hidden="true">
    <form class="search-panel__box" method="get" asp-controller="Shop" asp-action="Index" role="search">
        <label class="sr-only" for="search-input">@L["nav.search"]</label>
        <input id="search-input" name="q" type="search" placeholder="@L["search.placeholder"]" autocomplete="off" />
        <button class="btn btn--tan" type="submit">@L["nav.search"]</button>
        <button class="search-panel__close" id="search-close" type="button" aria-label="Close">×</button>
    </form>
</div>

<script src="~/js/brand.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>

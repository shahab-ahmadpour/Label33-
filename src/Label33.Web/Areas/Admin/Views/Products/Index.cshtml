@model IReadOnlyList<Label33.Application.Catalog.AdminProductListItemDto>
@{
    ViewData["Title"] = "Products";
    var q = ViewData["Q"] as string;
}

<section class="ops-page">
    <header class="ops-page__head">
        <div>
            <div class="eyebrow">Catalog</div>
            <h1>Products</h1>
        </div>
        <a class="btn btn--tan" href="/ops-33-console/products/create">New product</a>
    </header>

    <form method="get" class="ops-filters">
        <label>
            <span>Search</span>
            <input name="q" value="@q" placeholder="Name / slug / category" />
        </label>
        <button class="btn btn--ghost" type="submit">Search</button>
    </form>

    <div class="ops-panel">
        @if (Model.Count == 0)
        {
            <p class="ops-muted">No products.</p>
        }
        else
        {
            <table class="ops-table">
                <thead>
                    <tr>
                        <th></th>
                        <th>Name</th>
                        <th>Status</th>
                        <th>From (IRR)</th>
                        <th>Stock</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td class="ops-thumb-cell">
                            @if (!string.IsNullOrWhiteSpace(p.PrimaryImage))
                            {
                                <img class="ops-thumb" src="@p.PrimaryImage" alt="" />
                            }
                        </td>
                        <td>
                            @p.Name
                            <div class="ops-muted">@p.Slug</div>
                        </td>
                        <td><span class="ops-badge">@p.Status</span></td>
                        <td>@(p.FromPrice?.ToString("N0") ?? "—")</td>
                        <td>@(p.TotalOnHand?.ToString() ?? "—")</td>
                        <td><a class="ops-link" href="/ops-33-console/products/@p.Id">Edit</a></td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </div>
</section>

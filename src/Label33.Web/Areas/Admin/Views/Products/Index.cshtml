@model IReadOnlyList<Label33.Application.Catalog.AdminProductListItemDto>
@using Label33.Application.Catalog
@using Label33.Application.Common
@using Label33.Domain.Enums
@{
    ViewData["Title"] = "Products";
    var q = ViewData["Q"] as string;
    var categoryId = ViewData["CategoryId"] as Guid?;
    var status = ViewData["Status"] as ProductStatus?;
    var sort = ViewData["Sort"] as AdminProductSort? ?? AdminProductSort.UpdatedDesc;
    var categories = ViewData["Categories"] as IReadOnlyList<CategoryDto> ?? Array.Empty<CategoryDto>();
    var stats = ViewData["Stats"] as WarehouseStatsDto;
}

<section class="ops-page">
    <header class="ops-page__head">
        <div>
            <div class="eyebrow">Warehouse</div>
            <h1>Products</h1>
        </div>
        <a class="btn btn--tan" href="/ops-33-console/products/create">New product</a>
    </header>

    @if (stats is not null)
    {
        <div class="ops-stats ops-stats--warehouse">
            <article><div class="eyebrow">Products</div><strong>@stats.ProductCount</strong><span class="ops-muted">@stats.PublishedCount published</span></article>
            <article><div class="eyebrow">SKUs / sizes</div><strong>@stats.VariantCount</strong><span class="ops-muted">active variants</span></article>
            <article><div class="eyebrow">On hand</div><strong>@stats.TotalOnHand</strong><span class="ops-muted">reserved @stats.TotalReserved</span></article>
            <article><div class="eyebrow">Available</div><strong>@stats.Available</strong><span class="ops-muted">sellable units</span></article>
            <article><div class="eyebrow">Low stock</div><strong>@stats.LowStockVariants</strong><span class="ops-muted">≤ @CatalogDefaults.LowStockThreshold units</span></article>
            <article><div class="eyebrow">Out of stock</div><strong>@stats.OutOfStockVariants</strong><span class="ops-muted">sizes at 0</span></article>
        </div>
    }

    <form method="get" class="ops-filters ops-filters--wrap">
        <label>
            <span>Search</span>
            <input name="q" value="@q" placeholder="Name / SKU / category" />
        </label>
        <label>
            <span>Category</span>
            <select name="categoryId">
                <option value="">All categories</option>
                @foreach (var c in categories)
                {
                    if (categoryId == c.Id)
                    {
                        <option value="@c.Id" selected>@c.Name</option>
                    }
                    else
                    {
                        <option value="@c.Id">@c.Name</option>
                    }
                }
            </select>
        </label>
        <label>
            <span>Status</span>
            <select name="status">
                <option value="">All</option>
                @foreach (ProductStatus s in Enum.GetValues(typeof(ProductStatus)))
                {
                    if (status == s)
                    {
                        <option value="@s" selected>@s</option>
                    }
                    else
                    {
                        <option value="@s">@s</option>
                    }
                }
            </select>
        </label>
        <label>
            <span>Sort</span>
            <select name="sort">
                @if (sort == AdminProductSort.UpdatedDesc) { <option value="@AdminProductSort.UpdatedDesc" selected>Updated · newest</option> } else { <option value="@AdminProductSort.UpdatedDesc">Updated · newest</option> }
                @if (sort == AdminProductSort.UpdatedAsc) { <option value="@AdminProductSort.UpdatedAsc" selected>Updated · oldest</option> } else { <option value="@AdminProductSort.UpdatedAsc">Updated · oldest</option> }
                @if (sort == AdminProductSort.PriceAsc) { <option value="@AdminProductSort.PriceAsc" selected>Price · low to high</option> } else { <option value="@AdminProductSort.PriceAsc">Price · low to high</option> }
                @if (sort == AdminProductSort.PriceDesc) { <option value="@AdminProductSort.PriceDesc" selected>Price · high to low</option> } else { <option value="@AdminProductSort.PriceDesc">Price · high to low</option> }
                @if (sort == AdminProductSort.StockDesc) { <option value="@AdminProductSort.StockDesc" selected>Stock · highest</option> } else { <option value="@AdminProductSort.StockDesc">Stock · highest</option> }
                @if (sort == AdminProductSort.StockAsc) { <option value="@AdminProductSort.StockAsc" selected>Stock · lowest</option> } else { <option value="@AdminProductSort.StockAsc">Stock · lowest</option> }
                @if (sort == AdminProductSort.NameAsc) { <option value="@AdminProductSort.NameAsc" selected>Name · A–Z</option> } else { <option value="@AdminProductSort.NameAsc">Name · A–Z</option> }
            </select>
        </label>
        <div class="ops-filters__actions">
            <button class="btn btn--outline" type="submit">Apply</button>
        </div>
    </form>

    <div class="ops-panel">
        @if (Model.Count == 0)
        {
            <p class="ops-muted">No products match these filters.</p>
        }
        else
        {
            <table class="ops-table">
                <thead>
                    <tr>
                        <th></th>
                        <th>Product</th>
                        <th>Category</th>
                        <th>Status</th>
                        <th>From (@Money.DisplayUnit)</th>
                        <th>Available</th>
                        <th>On hand</th>
                        <th>OOS sizes</th>
                        <th>Updated</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var p in Model)
                {
                    <tr class="@(p.Available <= 0 ? "ops-row--danger" : p.Available <= CatalogDefaults.LowStockThreshold ? "ops-row--warn" : null)">
                        <td class="ops-thumb-cell">
                            @if (!string.IsNullOrWhiteSpace(p.PrimaryImage))
                            {
                                <img class="ops-thumb" src="@p.PrimaryImage" alt="" />
                            }
                        </td>
                        <td>
                            @p.Name
                            <div class="ops-muted">@p.Slug · @p.VariantCount sizes</div>
                        </td>
                        <td>@(p.Category ?? "—")</td>
                        <td><span class="ops-badge">@p.Status</span></td>
                        <td>@(p.FromPrice is null ? "—" : Money.FormatToman(p.FromPrice.Value))</td>
                        <td><strong>@p.Available</strong></td>
                        <td>@p.TotalOnHand <span class="ops-muted">/ r @p.TotalReserved</span></td>
                        <td>@p.OutOfStockSizes</td>
                        <td>@p.UpdatedAtUtc.ToString("yyyy-MM-dd HH:mm")</td>
                        <td><a class="ops-link" href="/ops-33-console/products/@p.Id">Edit</a></td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </div>
</section>

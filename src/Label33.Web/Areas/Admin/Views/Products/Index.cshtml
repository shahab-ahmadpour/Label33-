@model IReadOnlyList<Label33.Application.Catalog.ProductListItemDto>
@{
    ViewData["Title"] = "Products";
}

<section class="ops-page">
    <header class="ops-page__head">
        <div>
            <div class="eyebrow">Catalog</div>
            <h1>Products</h1>
        </div>
        <a class="btn btn--tan" href="/ops-33-console/products/create">New product</a>
    </header>

    <div class="ops-panel">
        @if (Model.Count == 0)
        {
            <p class="ops-muted">No published products.</p>
        }
        else
        {
            <table class="ops-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Slug</th>
                        <th>Category</th>
                        <th>From (IRR)</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td>@p.Name</td>
                        <td>@p.Slug</td>
                        <td>@(p.ShortDescription ?? "—")</td>
                        <td>@(p.FromPrice?.ToString("N0") ?? "—")</td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </div>
</section>

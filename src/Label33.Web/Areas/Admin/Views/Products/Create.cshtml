@using Label33.Application.Catalog
@using Label33.Application.Common
@{
    ViewData["Title"] = "New product";
    var categories = ViewData["Categories"] as IReadOnlyList<CategoryDto> ?? Array.Empty<CategoryDto>();
    var sizes = ViewData["Sizes"] as string[] ?? CatalogDefaults.Sizes;
    var defaultPrice = 89000m;
}

<section class="ops-page">
    <header class="ops-page__head">
        <div>
            <div class="eyebrow">Warehouse</div>
            <h1>New product</h1>
            <p class="ops-muted">Category, per-size price &amp; stock, and images.</p>
        </div>
        <a class="btn btn--ghost" href="/ops-33-console/products">Back</a>
    </header>

    <form method="post" action="/ops-33-console/products/create" enctype="multipart/form-data" class="ops-form ops-panel">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All" class="ops-errors"></div>

        <div class="ops-panel__head"><h2>Basics</h2></div>
        <label>
            <span>Name</span>
            <input name="name" required placeholder="Everyday Tee 33" />
        </label>
        <div class="ops-form__row">
            <label>
                <span>Category</span>
                <select name="categoryId" required>
                    <option value="">Select category</option>
                    @foreach (var c in categories)
                    {
                        <option value="@c.Id">@c.Name</option>
                    }
                </select>
            </label>
            <label>
                <span>SKU prefix</span>
                <input name="skuPrefix" required placeholder="33-TEE-001" />
            </label>
        </div>
        <label>
            <span>Description</span>
            <textarea name="fullDescription" rows="4" placeholder="Fabric, fit, care…"></textarea>
        </label>
        <div class="ops-form__row">
            <label>
                <span>Default price (@Money.DisplayUnit)</span>
                <input id="defaultPrice" name="price" type="number" min="0" step="1000" value="@defaultPrice" required />
            </label>
            <label class="ops-check" style="align-self:end">
                <input type="checkbox" name="isFeatured" value="true" />
                <span>Featured</span>
            </label>
        </div>
        <p class="ops-muted">Default price fills empty size prices. Each size can override it.</p>

        <div class="ops-panel__head" style="margin-top:1.25rem"><h2>Sizes &amp; stock</h2></div>
        <p class="ops-muted">Enable sizes, set stock and price per size. SKU = PREFIX-SIZE.</p>
        <div class="ops-size-grid">
            @foreach (var size in sizes)
            {
                var on = size is "S" or "M" or "L" or "XL";
                <div class="ops-size-card">
                    <label class="ops-check ops-size-card__head">
                        <input type="checkbox" name="sizeCodes" value="@size" @(on ? "checked" : null) />
                        <strong>@size</strong>
                    </label>
                    <label>
                        <span>Stock</span>
                        <input class="ops-size-card__input" name="stock_@size" type="number" min="0" value="@(size == "XL" ? 15 : 25)" />
                    </label>
                    <label>
                        <span>Price (@Money.DisplayUnit)</span>
                        <input class="ops-size-card__input ops-size-price" name="price_@size" type="number" min="0" step="1000" value="@defaultPrice" />
                    </label>
                </div>
            }
        </div>

        <div class="ops-panel__head" style="margin-top:1.25rem"><h2>Images</h2></div>
        <label>
            <span>Upload images</span>
            <input type="file" name="images" accept="image/jpeg,image/png,image/webp,image/gif" multiple />
        </label>
        <p class="ops-muted">First file becomes the primary image.</p>

        <label class="ops-check">
            <input type="checkbox" name="publish" value="true" checked />
            <span>Publish immediately</span>
        </label>

        <button class="btn btn--tan" type="submit">Create product</button>
    </form>
</section>
<script>
(() => {
  const def = document.getElementById('defaultPrice');
  if (!def) return;
  def.addEventListener('change', () => {
    document.querySelectorAll('.ops-size-price').forEach((el) => {
      if (!el.dataset.touched) el.value = def.value;
    });
  });
  document.querySelectorAll('.ops-size-price').forEach((el) => {
    el.addEventListener('input', () => { el.dataset.touched = '1'; });
  });
})();
</script>

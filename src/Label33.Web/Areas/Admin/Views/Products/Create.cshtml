@{
    ViewData["Title"] = "New product";
}

<section class="ops-page">
    <header class="ops-page__head">
        <div>
            <div class="eyebrow">Catalog</div>
            <h1>New product</h1>
        </div>
        <a class="btn btn--ghost" href="/ops-33-console/products">Back</a>
    </header>

    <form method="post" action="/ops-33-console/products/create" class="ops-form ops-panel">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All" class="ops-errors"></div>
        <label>
            <span>Name</span>
            <input name="name" required />
        </label>
        <label>
            <span>Category (T-SHIRTS / HOODIES / …)</span>
            <input name="category" placeholder="T-SHIRTS" />
        </label>
        <label>
            <span>SKU</span>
            <input name="sku" required placeholder="33-TEE-001" />
        </label>
        <div class="ops-form__row">
            <label>
                <span>Price (IRR)</span>
                <input name="price" type="number" min="0" step="1000" value="890000" required />
            </label>
            <label>
                <span>Stock</span>
                <input name="stock" type="number" min="0" value="20" required />
            </label>
        </div>
        <button class="btn btn--tan" type="submit">Create & publish</button>
    </form>
</section>

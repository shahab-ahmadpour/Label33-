@model Label33.Application.Catalog.AdminProductDetailDto
@using Label33.Application.Catalog
@using Label33.Application.Common
@using Label33.Domain.Enums
@{
    ViewData["Title"] = Model.Name;
    var categories = ViewData["Categories"] as IReadOnlyList<CategoryDto> ?? Array.Empty<CategoryDto>();
    var sizes = ViewData["Sizes"] as string[] ?? CatalogDefaults.Sizes;
    var bySize = Model.Variants.ToDictionary(v => v.Title.ToUpperInvariant(), v => v, StringComparer.OrdinalIgnoreCase);
}

<section class="ops-page">
    <header class="ops-page__head">
        <div>
            <div class="eyebrow">Warehouse</div>
            <h1>@Model.Name</h1>
            <p class="ops-muted"><span class="ops-badge">@Model.Status</span> · @(Model.CategoryName ?? "No category") · @Model.Slug</p>
        </div>
        <a class="btn btn--ghost" href="/ops-33-console/products">Back</a>
    </header>

    <div class="ops-grid-2">
        <form method="post" action="/ops-33-console/products/@Model.Id" class="ops-form ops-panel">
            @Html.AntiForgeryToken()
            <div class="ops-panel__head"><h2>Details</h2></div>
            <label>
                <span>Name</span>
                <input name="name" value="@Model.Name" required />
            </label>
            <label>
                <span>Category</span>
                <select name="categoryId" required>
                    @foreach (var c in categories)
                    {
                        if (Model.CategoryId == c.Id)
                        {
                            <option value="@c.Id" selected>@c.Name</option>
                        }
                        else
                        {
                            <option value="@c.Id">@c.Name</option>
                        }
                    }
                </select>
            </label>
            <label>
                <span>Description</span>
                <textarea name="fullDescription" rows="5">@Model.FullDescription</textarea>
            </label>
            <label class="ops-check">
                <input type="checkbox" name="isFeatured" value="true" @(Model.IsFeatured ? "checked" : null) />
                <span>Featured</span>
            </label>
            <button class="btn btn--tan" type="submit">Save details</button>
        </form>

        <div>
            <div class="ops-panel">
                <div class="ops-panel__head"><h2>Status</h2></div>
                <div class="ops-actions">
                    @if (Model.Status != ProductStatus.Published)
                    {
                        <form method="post" action="/ops-33-console/products/@Model.Id/publish">
                            @Html.AntiForgeryToken()
                            <button class="btn btn--tan" type="submit">Publish</button>
                        </form>
                    }
                    @if (Model.Status != ProductStatus.Archived)
                    {
                        <form method="post" action="/ops-33-console/products/@Model.Id/archive">
                            @Html.AntiForgeryToken()
                            <button class="btn btn--ghost" type="submit">Archive</button>
                        </form>
                    }
                    @if (Model.Status != ProductStatus.Published)
                    {
                        <form method="post" action="/ops-33-console/products/@Model.Id/delete" onsubmit="return confirm('Delete this product permanently?');">
                            @Html.AntiForgeryToken()
                            <button class="ops-link-danger" type="submit">Delete</button>
                        </form>
                    }
                </div>
            </div>

            <div class="ops-panel" style="margin-top:1rem">
                <div class="ops-panel__head"><h2>Images</h2></div>
                <div class="ops-image-grid">
                    @foreach (var img in Model.Images)
                    {
                        <figure class="ops-image-card">
                            <img src="@img.PathOrUrl" alt="@(img.AltText ?? "")" />
                            <figcaption>
                                @if (img.IsPrimary)
                                {
                                    <span class="ops-badge">Primary</span>
                                }
                                else
                                {
                                    <form method="post" action="/ops-33-console/products/images/@img.Id/primary">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="productId" value="@Model.Id" />
                                        <button type="submit" class="ops-link">Primary</button>
                                    </form>
                                }
                                <form method="post" action="/ops-33-console/products/images/@img.Id/delete" onsubmit="return confirm('Remove image?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="productId" value="@Model.Id" />
                                    <button type="submit" class="ops-link-danger">Remove</button>
                                </form>
                            </figcaption>
                        </figure>
                    }
                </div>
                <form method="post" action="/ops-33-console/products/@Model.Id/images" enctype="multipart/form-data" class="ops-form" style="margin-top:1rem">
                    @Html.AntiForgeryToken()
                    <label>
                        <span>Upload images</span>
                        <input type="file" name="files" accept="image/jpeg,image/png,image/webp,image/gif" multiple required />
                    </label>
                    <label class="ops-check">
                        <input type="checkbox" name="makePrimary" value="true" />
                        <span>First file as primary</span>
                    </label>
                    <button class="btn btn--tan" type="submit">Upload</button>
                </form>
            </div>
        </div>
    </div>

    <form method="post" action="/ops-33-console/products/@Model.Id/sizes" class="ops-form ops-panel" style="margin-top:1rem">
        @Html.AntiForgeryToken()
        <div class="ops-panel__head"><h2>Sizes &amp; inventory</h2></div>
        <p class="ops-muted">SKU prefix: <strong>@Model.SkuPrefix</strong> · Uncheck a size to deactivate it.</p>
        <label style="max-width:240px">
            <span>Default price (@Money.DisplayUnit)</span>
            <input id="editDefaultPrice" name="price" type="number" min="0" step="1000" value="@Money.ToToman(Model.BasePrice)" required />
        </label>
        <div class="ops-size-grid">
            @foreach (var size in sizes)
            {
                bySize.TryGetValue(size, out var variant);
                var enabled = variant?.IsActive == true;
                var stock = variant?.QuantityOnHand ?? 0;
                var reserved = variant?.QuantityReserved ?? 0;
                var sizePrice = Money.ToToman(variant?.BasePrice ?? Model.BasePrice);
                <div class="ops-size-card">
                    <label class="ops-check ops-size-card__head">
                        <input type="checkbox" name="sizeCodes" value="@size" @(enabled ? "checked" : null) />
                        <strong>@size</strong>
                    </label>
                    @if (variant is not null)
                    {
                        <div class="ops-muted">@variant.Sku · reserved @reserved · avail @(variant.Available == int.MaxValue ? "∞" : variant.Available)</div>
                    }
                    <label>
                        <span>Stock</span>
                        <input class="ops-size-card__input" name="stock_@size" type="number" min="0" value="@stock" />
                    </label>
                    <label>
                        <span>Price (@Money.DisplayUnit)</span>
                        <input class="ops-size-card__input" name="price_@size" type="number" min="0" step="1000" value="@sizePrice" />
                    </label>
                </div>
            }
        </div>
        <button class="btn btn--tan" type="submit">Save sizes &amp; stock</button>
    </form>
</section>
